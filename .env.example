# =============================================================
# .env.example — COPY THIS FILE TO .env AND FILL IN VALUES
# =============================================================
# Run this command: copy .env.example .env  (Windows)
#                   cp .env.example .env    (Mac/Linux)
# Then open .env and replace all placeholder values.
# =============================================================

PORT=3000
NODE_ENV=development
SESSION_SECRET=replace_with_random_secret_at_least_32_characters
AUTH_PROVIDER=local
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=talentops_sandbox
SANDBOX_DEFAULT_PASSWORD=replace_with_a_private_sandbox_password
# USERID from data/users.seed.json that receives the initial TalentOps ADMIN role
SANDBOX_INITIAL_ADMIN_JOBDIVA_USER_ID=

ATS_PROVIDER=jobdiva

BULLHORN_CLIENT_ID=
BULLHORN_CLIENT_SECRET=
BULLHORN_USERNAME=
BULLHORN_PASSWORD=
BULLHORN_AUTH_URL=
BULLHORN_TOKEN_URL=
BULLHORN_REST_URL=

CEIPAL_API_KEY=
CEIPAL_BASE_URL=

JOBDIVA_USERNAME=
JOBDIVA_PASSWORD=
JOBDIVA_BASE_URL=https://api.jobdiva.com
JOBDIVA_CLIENT_ID=


LEVER_API_KEY=
LEVER_BASE_URL=

AI_ENGAGED_JOB_UDF_FIELD=customText1
AI_ENGAGED_TYPE_FIELD=customText2
JOBDIVA_CANDIDATE_ACTIONS_ENDPOINT=
